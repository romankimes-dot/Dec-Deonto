{
  "name": "dec-deonto",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "for f in js/*.js sw.js cloudflare/worker.js; do node --check $f || exit 1; done && node --test 'tests/**/*.test.js'",
    "build": "python3 -I scripts/build_bank.py && python3 -I scripts/build_badges.py",
    "check": "python3 -I scripts/build_bank.py --check && python3 -I scripts/build_badges.py --check",
    "pdf": "node scripts/build_pdf.mjs",
    "serve": "python3 -m http.server 8080"
  }
}
